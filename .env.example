# ─── 빌드 후 이 파일을 .env 로 복사하고 값을 채운다 (.env 는 gitignore 됨) ───

# 1) Anthropic API 키 — console.anthropic.com 에서 발급
#    비어 있으면 AI 계층은 건너뛰고(장르=기타, 요약=제목) 파이프라인만 돈다.
ANTHROPIC_API_KEY=

# 2) VAPID 키 — `npm run vapid` 로 생성해서 여기에 붙여넣기
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# 3) 로컬 LLM (Ollama) — OLLAMA_MODEL 설정 시 모든 AI 호출이 로컬 우선,
#    실패하면 Anthropic(키 있으면) → 제목 폴백 순. 비우면 기존과 동일(Anthropic만).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

# ─── 선택 설정 (기본값 있음) ───
PORT=8787
# SQLite 파일 경로
DB_PATH=./data/briefing.sqlite
# 프론트(PWA) origin — CORS 허용용. 기본 vite dev 서버
WEB_ORIGIN=http://localhost:5173
# 스케줄러 타임존
TZ=Asia/Seoul
